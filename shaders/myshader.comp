layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_image;
layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    double center_x;
    double center_y;
    double scale;
    double root_x;
    double root_y;
    int   max_iter;
} pc;

// Controls how quickly the image scales down
float A = 1;

float TWO_PI = 6.28318530718;
int   N = 5;

// Complex multiplication
dvec2 cmul(dvec2 a, dvec2 b) { 
    return dvec2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x); 
}

// Complex inverse (1/z)
dvec2 cinv(dvec2 a){ 
    return dvec2(a.x, -a.y) / dot(a, a); 
}

// Create a color palette
// Reference: https://www.stevenfrady.com/tools/palette
vec3 palette(float t)
{
    // offset
    vec3 a = vec3(0.85, 0.80, 0.90);
    // amplitude
    vec3 b = vec3(0.15, 0.15, 0.15);
    // frequency
    vec3 c = vec3(1.0, 1.0, 1.0);
    // phase
    vec3 d = vec3(0.00, 0.33, 0.67);
    return a + b * cos(TWO_PI * (c * t + d));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    dvec2 z = dvec2(
        pc.center_x + (double(pixel.x) + 0.5lf - 0.5lf * double(pc.width))  * pc.scale,
        pc.center_y - (double(pixel.y) + 0.5lf - 0.5lf * double(pc.height)) * pc.scale);
    dvec2 m = dvec2(pc.root_x, pc.root_y);
    dvec2 one = dvec2(1.0lf, 0.0lf);
    dvec2 Ac = dvec2(pc.root_x, pc.root_y);  

    bool converged = false;
    int iter = 0;

    for (; iter < pc.max_iter; ++iter) {
        dvec2 z2 = cmul(z, z);
        dvec2 z4 = cmul(z2, z2);

        // Newton step for z^5 - 1:  (z - 1/z^4) / 5, scaled by complex A
        dvec2 stepv = cmul(Ac, (z - cinv(z4)) / double(N));
        z -= stepv;

        if (dot(stepv, stepv) < 1e-24lf) { converged = true; break; }
    }

    vec3 rgb = vec3(0.0);
    dvec2 d = z - m;
    int k;
    if (dot(d, d) < 1e-8lf) {
        k = N; 
    } else {
        float ang = atan(float(z.y), float(z.x));
        k = int(round(ang / (TWO_PI / float(N))));
        k = ((k % N) + N) % N;
    }

    float t = float(k) / float(N);
    float shade = 0.85 + 0.15 * pow(0.98, float(iter));
    rgb = palette(t);

    imageStore(out_image, pixel, vec4(rgb, 1.0));
}