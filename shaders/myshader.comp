#version 450

//--------------------------------------------------------------------------------------//
// PART B: YOUR COMPUTE CANVAS
//--------------------------------------------------------------------------------------//
// The real meat of the assignment. Your goal is to create something visually compelling
// that meets two of the three feature requirements and some more general requirements:
//
// Every visible pixel must be computed within the shader, rather than supplied to it.
// Ping-pong buffers do not count, since the prior result was also computed by the same
// shader.
//
// Pixel color depends in some form on pixel position. This could be from a more
// generalized coordinate system or directly from the integer coordinates of the pixel.
//
// The effect differs significantly from the provided shader and from your Assignment2
// implementation in nature.
//
// The effect is somewhat based on an existing procedural artistic concept. Pixel values
// cannot be hard-coded and must be derived from some calculation/algorithm.
//
// If you have an idea that you believe may not fully meet these requirements but still
// has artistic and intellectual merit, please reach out to me directly for idea approval.
//
// You are not required to use a single compute shader, though it is highly encouraged.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_image;
layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    double center_x;
    double center_y;
    double scale;
    double root_x;   // c.x  (p(z) = z^10 - c)
    double root_y;   // c.y
    int   max_iter;
} pc;

const float A = 1.0;            // relaxation: z <- z - A * p/p'
const float TWO_PI = 6.28318530718;
const int   N = 10;

vec2 cmul(vec2 a, vec2 b) { return vec2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x); }
vec2 cinv(vec2 a)         { return vec2(a.x, -a.y) / dot(a, a); }

vec3 hsv2rgb(vec3 c)
{
    vec3 p = abs(fract(c.xxx + vec3(0.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 z = vec2(pc.center_x + (pixel.x + 0.5 - 0.5 * pc.width)  * pc.scale,
                  pc.center_y - (pixel.y + 0.5 - 0.5 * pc.height) * pc.scale);
    vec2 c = vec2(pc.root_x, pc.root_y);

    bool converged = false;
    int iter = 0;

    for (; iter < pc.max_iter; ++iter) {
        if (dot(z, z) < 1e-12) break;                 // z ~ 0: p'(z) ~ 0

        // z^9 by repeated squaring
        vec2 z2 = cmul(z, z);
        vec2 z4 = cmul(z2, z2);
        vec2 z8 = cmul(z4, z4);
        vec2 z9 = cmul(z8, z);

        // p/p' = (z^10 - c) / (10 z^9) = (z - c / z^9) / 10
        vec2 step = A * (z - cmul(c, cinv(z9))) / float(N);
        z -= step;

        if (dot(step, step) < 1e-12) { converged = true; break; }
    }

    vec3 rgb = vec3(0.0);
    if (converged) {
        // which root? roots are at angle (arg(c) + 2*pi*k) / 10
        float ang  = atan(z.y, z.x);
        float cang = atan(c.y, c.x);
        int k = int(round((ang - cang / float(N)) / (TWO_PI / float(N))));
        k -= N * int(floor(float(k) / float(N)));     // wrap to 0..9

        float hue = float(k) / float(N);
        float shade = 0.35 + 0.65 * pow(0.93, float(iter)); // slow convergence = darker
        rgb = hsv2rgb(vec3(hue, 0.75, shade));
    }

    imageStore(out_image, pixel, vec4(rgb, 1.0));
}